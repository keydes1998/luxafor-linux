# /etc/udev/rules.d/90-luxafor.rules — uaccess ohne Root für den Desktop-User
# Luxafor Flag Gen1 (classic)
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="04d2", ATTRS{idProduct}=="bada", \
  MODE="0660", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="04d2", ATTRS{idProduct}=="bada", \
  MODE="0660", TAG+="uaccess"
# Luxafor Flag Gen2 (Microchip-Firmware, "LUXAFOR FLAG" product string)
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="04d8", ATTRS{idProduct}=="f372", \
  MODE="0660", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="04d8", ATTRS{idProduct}=="f372", \
  MODE="0660", TAG+="uaccess"
# Alle HID-Geräte mit Luxafor-Produktstring (weitere Modelle/Revisionen)
SUBSYSTEM=="hidraw", ATTRS{product}=="*LUXAFOR*", \
  MODE="0660", TAG+="uaccess"
# Alte Gen1-Geräte, weitere PIDs mit derselben VID
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="04d2", \
  MODE="0660", TAG+="uaccess"